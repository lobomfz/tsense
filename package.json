{
	"name": "tsense",
	"version": "0.1.0",
	"private": false,
	"description": "Opinionated, fully typed typesense client",
	"keywords": [
		"typesense"
	],
	"homepage": "https://github.com/lobomfz/tsense",
	"license": "MIT",
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./filters": {
			"types": "./dist/filters/index.d.ts",
			"import": "./dist/filters/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsgo",
		"check": "bun run scripts/check.ts",
		"ci": "bun run build && bun run format && bun run check-exports",
		"test": "bun test",
		"format": "oxfmt check --write src tests",
		"check-exports": "attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution",
		"local-release": "changeset version && changeset publish",
		"prepublishOnly": "bun run ci"
	},
	"dependencies": {
		"redaxios": "^0.5.1"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.2",
		"@changesets/cli": "^2.30.0",
		"@types/bun": "latest",
		"@types/node": "^25.5.0",
		"@types/react": "^19.2.14",
		"@typescript/native-preview": "^7.0.0-dev.20260324.1",
		"arktype": "^2.2.0",
		"jscpd": "^4.0.8",
		"oxfmt": "^0.42.0",
		"oxlint": "^1.57.0",
		"react": "^19.2.4"
	},
	"peerDependencies": {
		"arktype": "^2.1.29",
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}