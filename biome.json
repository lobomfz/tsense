{
  "$schema": "https://biomejs.dev/schemas/2.1.4/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "nursery": {
        "noAwaitInLoop": "off",
        "noImportCycles": "off",
        "noUselessBackrefInRegex": "error",
        "useConsistentObjectDefinition": "warn",
        "useExhaustiveSwitchCases": "error",
        "useNumericSeparators": "error"
      },
      "correctness": {
        "noUnusedImports": "warn",
        "noChildrenProp": "warn",
        "noConstAssign": "error",
        "noConstantMathMinMaxClamp": "error",
        "noConstructorReturn": "error",
        "noEmptyCharacterClassInRegex": "error",
        "noEmptyPattern": "warn",
        "noGlobalObjectCalls": "error",
        "noInnerDeclarations": "error",
        "noInvalidConstructorSuper": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noNonoctalDecimalEscape": "error",
        "noPrecisionLoss": "error",
        "noRenderReturnValue": "error",
        "noSelfAssign": "error",
        "noSetterReturn": "error",
        "noStringCaseMismatch": "error",
        "noSwitchDeclarations": "error",
        "noUnreachableSuper": "warn",
        "noUnsafeFinally": "warn",
        "noUnsafeOptionalChaining": "error",
        "noUnusedPrivateClassMembers": "warn",
        "noVoidElementsWithChildren": "error",
        "noVoidTypeReturn": "error",
        "useHookAtTopLevel": "warn",
        "useIsNan": "error",
        "useJsxKeyInIterable": "warn",
        "noInvalidBuiltinInstantiation": "error",
        "useValidTypeof": "error"
      },
      "style": {
        "useImportType": "warn",
        "noDefaultExport": "error",
        "noInferrableTypes": "warn",
        "noUnusedTemplateLiteral": "error",
        "useConst": "warn",
        "useAsConstAssertion": "error",
        "noUselessElse": "error",
        "useArrayLiterals": "error"
      },
      "a11y": {},
      "complexity": {
        "noThisInStatic": "error",
        "noUselessCatch": "warn",
        "noBannedTypes": "off",
        "noEmptyTypeParameters": "warn",
        "noStaticOnlyClass": "error",
        "noUselessConstructor": "warn",
        "noUselessEmptyExport": "warn",
        "noUselessFragments": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessRename": "warn",
        "noUselessSwitchCase": "warn",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "warn",
        "useFlatMap": "warn",
        "useOptionalChain": "error",
        "useRegexLiterals": "warn",
        "useSimpleNumberKeys": "error",
        "noFlatMapIdentity": "error",
        "noUselessContinue": "warn",
        "noAdjacentSpacesInRegex": "warn"
      },
      "performance": {
        "noAccumulatingSpread": "warn",
        "noBarrelFile": "off",
        "noReExportAll": "warn"
      },
      "suspicious": {
        "noApproximativeNumericConstant": "error",
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "error",
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noClassAssign": "error",
        "noCommentText": "error",
        "noCompareNegZero": "error",
        "noConfusingVoidType": "error",
        "noConstEnum": "error",
        "noDebugger": "error",
        "noControlCharactersInRegex": "error",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noDuplicateTestHooks": "error",
        "noEmptyInterface": "warn",
        "noExtraNonNullAssertion": "warn",
        "noFallthroughSwitchClause": "warn",
        "noFunctionAssign": "error",
        "noGlobalAssign": "error",
        "noGlobalIsFinite": "error",
        "noImportAssign": "error",
        "noLabelVar": "error",
        "noMisleadingCharacterClass": "error",
        "noMisleadingInstantiator": "error",
        "noMisrefactoredShorthandAssign": "error",
        "noPrototypeBuiltins": "error",
        "noSelfCompare": "error",
        "noShadowRestrictedNames": "warn",
        "noSparseArray": "error",
        "noThenProperty": "error",
        "noUnsafeDeclarationMerging": "error",
        "noUnsafeNegation": "error",
        "useAwait": "warn",
        "useDefaultSwitchClauseLast": "warn",
        "useIsArray": "error",
        "noWith": "error"
      },
      "security": {
        "noBlankTarget": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "tab",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "all"
    }
  },
  "files": {
    "includes": ["**", "!**/dist"]
  }
}
